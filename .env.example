PORT=4310
# demo: local synthetic data + deterministic question routing, no LLM or Snowflake calls.
# live: CoCo SDK interpretation + real Snowflake semantic queries. Never falls back to demo.
ANALYSIS_MODE=demo
CORTEX_CODE_CLI_PATH=cortex
CORTEX_CONNECTION=qbr
CORTEX_MODEL=auto
# Dedicated restricted Snowflake identity; do not use ACCOUNTADMIN for the runtime.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_AUTHENTICATOR=EXTERNALBROWSER
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=COCO_QBR_READER
SNOWFLAKE_WAREHOUSE=COCO_QBR_WH
# Enable only after setting restricted-role grants and loading sql/.
LIVE_ACCESS_VERIFIED=false
# Zoom transcript capture is separate from analysis mode.
ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZOOM_WEBHOOK_SECRET=
# Reject RTMS events for other meetings. Set the exact meeting UUID (not numeric meeting ID).
ZOOM_MEETING_UUID=
